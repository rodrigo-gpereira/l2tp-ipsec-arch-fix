# Maintainer: rodrigo.dev.ux@outlook.com
# PKGBUILD customizado: adiciona -DCONFIG_WATCHDOG_FIREWALL ao build do
# xl2tpd oficial. Corrige rejeição silenciosa do ICCN (AVP "RX Connect
# Speed") por servidores accel-ppp, que derruba a conexão L2TP logo após o
# handshake com "Received out of order control packet".
#
# Mesmos caminhos do pacote oficial (repo extra) — substitui direto via
# pacman -U, sem conflito de arquivos.
pkgname=xl2tpd
pkgver=1.3.20
pkgrel=1
pkgdesc="xl2tpd com CONFIG_WATCHDOG_FIREWALL (fix pra ICCN rejeitado por accel-ppp)"
arch=('x86_64')
url="https://github.com/xelerance/xl2tpd"
license=('GPL-2.0-or-later')
depends=('ppp')
backup=('etc/ppp/options.l2tpd')
source=("https://github.com/xelerance/xl2tpd/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('3db95450c5e1efaeea7547af344b5621f4453af3c227f26ec43bcbc79087b045')

build() {
  cd "$pkgname-$pkgver"
  make DFLAGS="-DDEBUG_PPPD -DTRUST_PPPD_TO_DIE -DCONFIG_WATCHDOG_FIREWALL" \
    xl2tpd xl2tpd-control
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 xl2tpd "$pkgdir/usr/bin/xl2tpd"
  install -Dm755 xl2tpd-control "$pkgdir/usr/bin/xl2tpd-control"
  install -Dm644 doc/xl2tpd.8 "$pkgdir/usr/share/man/man8/xl2tpd.8"
  install -Dm644 doc/xl2tpd-control.8 "$pkgdir/usr/share/man/man8/xl2tpd-control.8"
  install -Dm644 doc/xl2tpd.conf.5 "$pkgdir/usr/share/man/man5/xl2tpd.conf.5"
  install -Dm644 doc/l2tp-secrets.5 "$pkgdir/usr/share/man/man5/l2tp-secrets.5"
  install -Dm644 examples/xl2tpd.conf "$pkgdir/etc/xl2tpd/xl2tpd.conf.client-example"
  install -Dm644 examples/xl2tpd.conf "$pkgdir/etc/xl2tpd/xl2tpd.conf.server-example"
  install -Dm644 examples/ppp-options.xl2tpd "$pkgdir/etc/ppp/options.l2tpd"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/xl2tpd.service" <<'EOF'
[Unit]
Description=Level 2 Tunnel Protocol Daemon (L2TP)
After=network.target
After=ipsec.service

[Service]
Type=simple
PIDFile=/run/xl2tpd/xl2tpd.pid
ExecStart=/usr/bin/xl2tpd -D
Restart=on-abort

[Install]
WantedBy=multi-user.target
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/tmpfiles.d/xl2tpd.conf" <<'EOF'
d /run/xl2tpd 0755 root root -
EOF
}
